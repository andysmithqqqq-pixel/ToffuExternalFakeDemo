<!DOCTYPE html>
<html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no"><meta name="color-scheme" content="dark light"><title>Toffu</title>
<style>
:root{--bg:#0f0f10;--fg:#d6d6d6;--card:#151516;--bd:#232325;--muted:#777;--sub:#a0a0a0;--btn:#1d1d1f;--btnbd:#2c2c2f;--accent:#a8d5ba;--accent-text:#14201a;--ink:#a8d5ba;--modal:#171718;--modalbd:#2a2a2c;--mtext:#9a9a9f;--overlay:rgba(0,0,0,.55);--err:#d99a9a;--log:#8f8f94}
:root[data-theme=light]{--bg:#f4f4f5;--fg:#222226;--card:#fff;--bd:#e3e3e6;--muted:#8a8a90;--sub:#66666c;--btn:#f0f0f2;--btnbd:#dcdce0;--accent:#a8d5ba;--accent-text:#14201a;--ink:#4f8a68;--modal:#fff;--modalbd:#e3e3e6;--mtext:#66666c;--overlay:rgba(0,0,0,.35);--err:#c26a6a;--log:#66666c}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}html,body{height:100%;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,sans-serif}.app{height:100dvh;max-width:480px;margin:auto;display:flex;flex-direction:column}header{padding:18px}h1{font-size:21px;font-weight:600}header div{color:var(--muted);font-size:13px}main{padding:0 14px;flex:1;min-height:0;display:flex;flex-direction:column}.card,.notice,.list{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-bottom:12px}.notice{font-size:13px;color:var(--sub)}.kv{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px solid var(--bd);font-size:14px}.kv:last-child{border:0}.kv span:first-child{color:var(--muted)}button{font:inherit;color:var(--fg);background:var(--btn);border:1px solid var(--btnbd);border-radius:8px;padding:9px 12px}.primary{width:100%;padding:13px;background:var(--accent);color:var(--accent-text);border:0;font-weight:600;border-radius:10px}.bottom{margin-top:auto;padding-bottom:12px}.status{display:none;text-align:center;color:var(--log);font-size:12px;margin-top:8px}nav{display:flex;border-top:1px solid var(--bd);background:var(--card)}nav button{flex:1;border:0;border-radius:0;background:none;color:var(--muted);font-size:11px;padding:12px 0}nav button.active{color:var(--ink)}.screen{display:none;flex:1;min-height:0}.screen.active{display:flex;flex-direction:column}.logbox{font:12px/1.7 monospace;overflow:auto;white-space:pre-wrap}.cfgrow,.setting{padding:10px 0;border-bottom:1px solid var(--bd);display:flex;justify-content:space-between;gap:8px;align-items:center}.ov{position:fixed;inset:0;background:var(--overlay);display:none;align-items:center;justify-content:center;padding:20px;z-index:5}.modal{background:var(--modal);border:1px solid var(--modalbd);border-radius:16px;padding:28px 24px;width:100%;max-width:320px;text-align:center}.modal svg{width:64px;height:64px;stroke-width:2;fill:none;margin-bottom:14px}.modal.err svg{stroke:var(--err)}.modal.ok svg{stroke:var(--ink)}.modal h2{font-size:18px;margin-bottom:10px}.modal p{color:var(--mtext);font-size:13.5px;line-height:1.8}.modal button{margin-top:18px;width:100%}.actions{display:flex;gap:8px}.actions button{flex:1}
</style></head><body><div class="app"><header><h1>Toffu External</h1><div>External loader · Matreshka RP</div></header><main>
<section class="screen active" id="home"><div class="notice"><b>Нужны root-права.</b> Без них запуск оверлея ограничен.</div><div class="card"><div class="kv"><span>Игра</span><span>Matreshka RP</span></div><div class="kv"><span>Root</span><span id="rootState">не проверен</span></div><div class="kv"><span>Телефон</span><span id="model">…</span></div><div class="kv"><span>Android</span><span id="android">…</span></div><div class="kv"><span>Конфиг</span><span id="selectedCfg">нет</span></div></div><div class="bottom"><div class="actions"><button id="start" class="primary">Запустить</button><button id="stop">Остановить</button></div><div class="status" id="status">Проверка запуска…</div></div></section>
<section class="screen" id="logs"><div class="list logbox" id="logbox">Логов нет</div></section>
<section class="screen" id="cfgs"><div class="card"><b>Конфиги (.tcf)</b><div class="actions" style="margin-top:10px"><button id="newcfg">Создать</button><button id="importcfg">Импорт</button><input id="file" type="file" accept=".tcf" multiple hidden></div><div id="cfglist"></div></div></section>
<section class="screen" id="settings"><div class="card"><div class="setting"><span>Тема</span><select id="theme"><option value="dark">Тёмная</option><option value="light">Светлая</option></select></div><div class="setting"><span>Время в логах</span><input type="checkbox" id="timestamps" checked></div><div class="setting"><span>Размер плашки</span><input type="range" id="pillsize" min="80" max="125" value="100"></div><div class="setting"><span>Скорость логов</span><select id="speed"><option value=".5">Быстро</option><option value="1">Нормально</option><option value="1.7">Медленно</option></select></div><button id="reset" style="width:100%;margin-top:12px">Сбросить настройки</button></div></section>
</main><nav><button class="active" data-tab="home">Запуск</button><button data-tab="logs">Логи</button><button data-tab="cfgs">Конфиги</button><button data-tab="settings">Настройки</button></nav></div>
<div class="ov" id="ov"><div class="modal err" id="modal"><svg id="ico" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 3L22 20H2L12 3Z"/><path d="M12 10V14"/><circle cx="12" cy="17" r="1" class="filled-only"/></svg><h2 id="mt">Рут не найден!</h2><p id="info">Рут права не найдены. Пожалуйста, выдайте их самостоятельно. Если рут прав нету - чит работать не будет.</p><button id="close">Закрыть</button></div></div>
<script>
const $=s=>document.querySelector(s), logs=[], cfgs=[]; let running=false, settings={theme:'dark',ts:true,speed:1,pillsize:100}, selected=-1;
function persist(){try{localStorage.setItem('toffu_settings',JSON.stringify(settings));localStorage.setItem('toffu_cfgs',JSON.stringify(cfgs))}catch(e){}}
try{settings={...settings,...JSON.parse(localStorage.getItem('toffu_settings')||'{}')};cfgs.push(...JSON.parse(localStorage.getItem('toffu_cfgs')||'[]'))}catch(e){}
function theme(){document.documentElement.dataset.theme=settings.theme;$('#theme').value=settings.theme} theme();
function addLog(s){let t=new Date().toLocaleTimeString();logs.push((settings.ts?'['+t+'] ':'')+s);$('#logbox').textContent=logs.join('\n');$('#logbox').scrollTop=$('#logbox').scrollHeight}
function modal(title,body,ok=false){$('#modal').className='modal '+(ok?'ok':'err');$('#mt').textContent=title;$('#info').textContent=body;$('#ico').innerHTML=ok?'<path d="M4 12L10 18L20 6"/>':'<path d="M12 3L22 20H2L12 3Z"/><path d="M12 10V14"/><circle cx="12" cy="17" r="1"/>';$('#ov').style.display='flex'}
function closeModal(){$('#ov').style.display='none';$('#status').style.display='none';$('#start').disabled=false;running=false}
$('#close').onclick=closeModal;
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.screen').forEach(x=>x.classList.toggle('active',x.id===b.dataset.tab))});
function native(){return !!window.ToffuNative}
function deviceInfo(){if(native()){ $('#model').textContent=ToffuNative.deviceModel();$('#android').textContent=ToffuNative.androidVersion()}else{$('#model').textContent='не определена';$('#android').textContent='не определена'}}
deviceInfo();
$('#start').onclick=async()=>{if(running)return;running=true;$('#start').disabled=true;$('#status').style.display='block';logs.length=0;$('#logbox').textContent='';addLog('Инициализация Toffu');addLog('Проверка Android');if(!native()){addLog('Android bridge недоступен');modal('Ошибка запуска','Откройте приложение Toffu на Android.');return}
addLog('Проверка root через su');let root=ToffuNative.checkRoot();if(root!=='ROOT_OK'){addLog('Root не найден или запрос отклонён');$('#rootState').textContent='не найден';modal('Рут не найден!','Рут права не найдены. Пожалуйста, выдайте их самостоятельно. Если рут прав нету - чит работать не будет.');return}
$('#rootState').textContent='доступен';addLog('Root подтверждён');addLog('Проверка пакета игры');if(!ToffuNative.gameInstalled()){addLog('Игра не найдена: com.critical.strike.fps.cops.counter.terrorists.free.fire.games');modal('Игра не найдена','Matreshka RP не установлена. Установите игру и запустите загрузчик снова.');return}
addLog('Пакет игры найден');ToffuNative.requestOverlay();addLog('Запрос разрешения на отображение поверх приложений');ToffuNative.launchGame();addLog('Отправлена команда запуска Matreshka RP');setTimeout(()=>{let pid=ToffuNative.pid();addLog('PID процесса: '+pid);modal('Успешно!','Сессия авторизована. Android: '+ToffuNative.androidVersion()+' PID: '+pid,true)},1800);
};
$('#stop').onclick=()=>{if(native())ToffuNative.stopOverlay();addLog('Оверлей остановлен');toast('Оверлей остановлен')};
function toast(s){$('#status').textContent=s;$('#status').style.display='block';setTimeout(()=>$('#status').style.display='none',2200)}
function drawCfgs(){let box=$('#cfglist');box.innerHTML='';cfgs.forEach((c,i)=>{let row=document.createElement('div');row.className='cfgrow';let n=document.createElement('span');n.textContent=c.name+(i===selected?' ✓':'');n.onclick=()=>{selected=i;$('#selectedCfg').textContent=c.name;drawCfgs()};let rename=document.createElement('button');rename.textContent='Имя';rename.onclick=()=>{let v=prompt('Имя конфига',c.name);if(v&&v.trim()){c.name=v.trim();persist();drawCfgs()}};let del=document.createElement('button');del.textContent='×';del.onclick=()=>{cfgs.splice(i,1);if(selected===i)selected=-1;persist();drawCfgs()};row.append(n,rename,del);box.append(row)});if(!cfgs.length)box.textContent='Нет конфигов'}
$('#newcfg').onclick=()=>{let name=prompt('Название конфига');if(!name||!name.trim())return;cfgs.push({name:name.trim(),data:JSON.stringify({created:new Date().toISOString(),settings})});persist();drawCfgs();$('#selectedCfg').textContent=name.trim()};
$('#importcfg').onclick=()=>$('#file').click();
$('#file').onchange=async e=>{for(const f of e.target.files){try{let data=await f.text();let j=JSON.parse(data);if(j&&typeof j==='object'&&!Array.isArray(j))cfgs.push({name:f.name.replace(/\.tcf$/i,''),data});else toast('Неверный .tcf')}catch(_){toast('Неверный .tcf')}}persist();drawCfgs();e.target.value=''};
$('#theme').onchange=()=>{settings.theme=$('#theme').value;theme();persist()};
$('#timestamps').onchange=()=>{settings.ts=$('#timestamps').checked;persist()};
$('#speed').onchange=()=>{settings.speed=+$('#speed').value;persist()};
$('#pillsize').oninput=()=>{settings.pillsize=+$('#pillsize').value;persist()};
$('#reset').onclick=()=>{settings={theme:'dark',ts:true,speed:1,pillsize:100};persist();theme();$('#timestamps').checked=true;$('#speed').value='1';$('#pillsize').value=100;toast('Настройки сброшены')};
function drawCfgsInitial(){drawCfgs();$('#timestamps').checked=settings.ts;$('#speed').value=String(settings.speed);$('#pillsize').value=settings.pillsize}
drawCfgsInitial();
window.nativeResume=()=>{deviceInfo()};
</script></body></html>
